# ============================================================================
# WatchDogs Security City - Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (already in .gitignore)
# ============================================================================

# ============================================================================
# LLM CONFIGURATION (REQUIRED)
# ============================================================================
# LLM_PROVIDER selects endpoint + default model: groq | openai | ollama | custom
# Any of OPENAI_BASE_URL / OPENAI_MODEL / OPENAI_API_KEY overrides its piece.
#
# --- Groq (default; deployed) ---
LLM_PROVIDER=groq
OPENAI_API_KEY=your-groq-api-key-here
# OPENAI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4.1-mini
#
# --- Local Ollama (use a NON-reasoning vision model, e.g. qwen3-vl:8b-instruct) ---
# LLM_PROVIDER=ollama
# OPENAI_MODEL=qwen3-vl:8b-instruct

# Hard HTTP timeout per LLM request, concurrency cap, and token cap
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_CONCURRENCY=16
# OPENAI_MAX_TOKENS=4096

# Daily LLM budget (provider calls; a full analysis = 16 per frame)
# LLM_DAILY_CALL_LIMIT=480
# LLM_DAILY_CALL_LIMIT_PER_USER=320

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================================
# VIDEO CONFIGURATION
# ============================================================================
# Maximum video size in MB
MAX_VIDEO_SIZE_MB=50

# Uploaded videos are deleted by a background job after this many minutes
VIDEO_RETENTION_MINUTES=15

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Cross-origin access is OFF by default (the SPA is same-origin). Only if a separate frontend needs it:
# ALLOWED_ORIGINS=https://your-frontend.example

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Authentication is MANDATORY (web app and API). The app refuses to start without credentials.
# ADMIN_PASSWORD: at least 12 characters with upper case, lower case and a digit,
# or at least 32 random characters (e.g. Render's "Generate") without composition rules.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-Passw0rd
# For local development only (rejected when FLASK_ENV=production or on Render):
# AUTH_ENABLED=false

# Flask secret key; signs session tokens (generate: python -c "import secrets; print(secrets.token_hex(32))")
# Required in production; in development a random key is used (sessions die on restart)
FLASK_SECRET_KEY=generate-a-long-random-value

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Timeout per agent in seconds
AGENT_TIMEOUT_SECONDS=30

# Retry configuration for failed agent calls
AGENT_RETRY_MAX_ATTEMPTS=3
AGENT_RETRY_MIN_WAIT=2.0
AGENT_RETRY_MAX_WAIT=10.0

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Enable caching of agent results (saves API costs for repeated images)
CACHE_ENABLED=True

# Cache time-to-live in seconds (results are not kept longer than needed)
CACHE_TTL_SECONDS=300

# ============================================================================
# CIRCUIT BREAKER CONFIGURATION
# ============================================================================
# Enable circuit breaker pattern (protects against cascading failures)
CIRCUIT_BREAKER_ENABLED=True

# Number of consecutive failures before opening circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before attempting recovery
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0

# ============================================================================
# METRICS CONFIGURATION
# ============================================================================
# Enable metrics collection (latency, success rate, etc.)
METRICS_ENABLED=True

# ============================================================================
# DEVELOPMENT / PRODUCTION SETTINGS
# ============================================================================
# For production, use these settings:
# FLASK_ENV=production
# FLASK_DEBUG=False
# FLASK_HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-production-domain.com
# RATE_LIMIT_PER_MINUTE=10  # Stricter in production
# CACHE_ENABLED=True
# METRICS_ENABLED=True

# ============================================================================
# MAPBOX CONFIGURATION (OPTIONAL)
# ============================================================================
# Interactive map for geolocation results and chat-based location discovery
# Get your token from: https://account.mapbox.com/access-tokens/
# If not set, map features degrade gracefully (text-only geolocation)
# MAP_BOX_ACCESS_TOKEN=pk.your-mapbox-token-here

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================
# Uncomment and modify if needed

# Path for temporary video storage (default: data/temp)
# TEMP_VIDEO_PATH=data/temp

# LLM model tuning (defaults already set in config.py)
# OPENAI_TEMPERATURE=0.3

# ============================================================================
# NOTES
# ============================================================================
# 1. LLM config is REQUIRED - set either OpenAI API key or local server URL
# 2. For local development with LM Studio, default values above are fine
# 3. For production:
#    - Set FLASK_DEBUG=False
#    - Set FLASK_ENV=production
#    - Configure proper ALLOWED_ORIGINS
#    - Consider stricter RATE_LIMIT_PER_MINUTE
#    - Enable CACHE_ENABLED and METRICS_ENABLED
# 4. Cost estimation:
#    - see README (measured tokens per analysis) for cost estimates
#    - Cache reduces costs for repeated images
#    - Monitor usage at https://platform.openai.com/usage
# ============================================================================
